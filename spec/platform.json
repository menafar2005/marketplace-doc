  "httpStatuses": [
    {
      "status": 400,
      "meaning": "بدنه یا پارامتر نامعتبر",
      "action": "ورودی و casing را اصلاح کنید."
    },
    {
      "status": 401,
      "meaning": "token/credentials نامعتبر",
      "action": "launch جدید آغاز کنید؛ token را refresh نکنید."
    },
    {
      "status": 403,
      "meaning": "scope یا entity مجاز نیست",
      "action": "قابلیت را غیرفعال کنید؛ با retry حل نمی‌شود."
    },
    {
      "status": 404,
      "meaning": "منبع پیدا نشد",
      "action": "شناسه و وضعیت نصب را بررسی کنید."
    },
    {
      "status": 409,
      "meaning": "تعارض یا code مصرف‌شده",
      "action": "عملیات را idempotent کنید؛ launch تازه بگیرید."
    },
    {
      "status": 410,
      "meaning": "code منقضی شده",
      "action": "کاربر باید اکستنشن را دوباره اجرا کند."
    },
    {
      "status": 422,
      "meaning": "قاعده کسب‌وکار رعایت نشده",
      "action": "پیام validation مناسب نمایش دهید."
    },
    {
      "status": 502,
      "meaning": "خطا یا timeout در دیدار",
      "action": "retry محدود با backoff و correlation id."
    }
  ],
  "errorCodes": [
    {
      "code": "INVALID_CLIENT_CREDENTIALS",
      "meaning": "credentials اپ (ClientId / ClientSecret) اشتباه است."
    },
    {
      "code": "LAUNCH_CODE_INVALID",
      "meaning": "launch code معتبر یا متعلق به این اپ نیست."
    },
    {
      "code": "LAUNCH_CODE_ALREADY_USED",
      "meaning": "کد یک‌بارمصرف قبلاً استفاده شده."
    },
    {
      "code": "LAUNCH_CODE_EXPIRED",
      "meaning": "کد منقضی شده است."
    },
    {
      "code": "RUNTIME_TOKEN_INVALID",
      "meaning": "context توکن ناقص یا نامعتبر است."
    },
    {
      "code": "PROXY_ACCESS_DENIED",
      "meaning": "scope لازم به اپ داده نشده است."
    },
    {
      "code": "RUNTIME_ENTITY_TYPE_DENIED",
      "meaning": "نوع entity با context اجرا سازگار نیست."
    },
    {
      "code": "RUNTIME_ENTITY_ACCESS_DENIED",
      "meaning": "شناسه در entityIds مجاز وجود ندارد."
    },
    {
      "code": "DIDAR_API_KEY_NOT_CONFIGURED",
      "meaning": "نصب credential قابل‌استفاده ندارد."
    },
    {
      "code": "DIDAR_PROXY_UNAVAILABLE",
      "meaning": "ارتباط با دیدار برقرار نشد."
    },
    {
      "code": "DIDAR_PROXY_TIMEOUT",
      "meaning": "دیدار در زمان مقرر پاسخ نداد."
    },
    {
      "code": "DIDAR_PROXY_FAILED",
      "meaning": "دیدار درخواست upstream را رد کرد."
    },
    {
      "code": "DIDAR_PROXY_INVALID_RESPONSE",
      "meaning": "پاسخ دیدار قابل پردازش نبود."
    }
  ],
