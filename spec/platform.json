    },
    {
      "code": "DIDAR_API_KEY_NOT_CONFIGURED",
      "meaning": "نصب credential قابل‌استفاده ندارد."
    },
    {
      "code": "DIDAR_PROXY_UNAVAILABLE",
      "meaning": "ارتباط با دیدار برقرار نشد."
    },
    {
      "code": "DIDAR_PROXY_TIMEOUT",
      "meaning": "دیدار در زمان مقرر پاسخ نداد."
    },
    {
      "code": "DIDAR_PROXY_FAILED",
      "meaning": "دیدار درخواست upstream را رد کرد."
    },
    {
      "code": "DIDAR_PROXY_INVALID_RESPONSE",
      "meaning": "پاسخ دیدار قابل پردازش نبود."
    }
